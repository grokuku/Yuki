# =============================================================================
# Yuki — déploiement SERVEUR : variables d'environnement (`.env`).
#
#   cp .env.example .env   # puis renseigner les 2 clés LLM ci-dessous
#
# ⚠️  Aucune vraie clé ne doit être commitée. `.env` reste local au serveur.
# Ce fichier ne liste que le strict nécessaire : tout le reste (chemins de
# volumes, identité du SDK Pi, GPU…) a un défaut sûr directement dans
# `docker-compose.yml`.
# =============================================================================

# --- Image tirée -------------------------------------------------------------
# Tag de l'image : `ghcr.io/grokuku/yuki:${YUKI_VERSION:-latest}`.
# Laissé commenté -> `:latest` (n'existe QUE si le workflow de release a déjà
# tourné au moins une fois ; sinon utiliser `test`). Épingler une version :
# YUKI_VERSION=0.1.0   # ou : YUKI_VERSION=test
# YUKI_VERSION=0.1.0

# --- Gateway (port HÔTE) -----------------------------------------------------
# Le port CONTENEUR reste 8080 ; ceci ne change que le port publié sur l'hôte.
YUKI_GATEWAY_PORT=8080

# --- Clés LLM (obligatoires pour l'usage normal) -----------------------------
# Laisser vide fait démarrer proprement, mais différemment selon le rôle :
#   * clé LEGERE absente  -> `/health/ready` = 503, conversation indisponible ;
#   * clé LOURDE absente  -> délégation désactivée, conversation fonctionnelle.
YUKI_LLM_LIGHT_API_KEY=
YUKI_LLM_HEAVY_API_KEY=

# --- LLM : valeur modifiable -------------------------------------------------
# `baseUrl` et l'identifiant de modèle servent aussi de défaut au code, mais le
# fichier de référence du fournisseur reste `models.json` (volume `yuki-server-pi`,
# voir le README). Ces variables surchargent le défaut du code au démarrage.
# YUKI_LLM_LIGHT_BASE_URL=https://ollama.com/v1
# YUKI_LLM_LIGHT_MODEL=gemma4:31b
# YUKI_LLM_HEAVY_BASE_URL=https://ollama.com/v1
# YUKI_LLM_HEAVY_MODEL=deepseek-v4.1-flash

# --- Identité conteneur (⚠️ piège) -------------------------------------------
# L'image publiée est construite avec uid/gid 1000. NE PAS changer ces valeurs
# sans reconstruire l'image : le conteneur non-root ne serait plus propriétaire
# des volumes nommés et `/health/ready` tomberait en 503 (permission denied).
# YUKI_UID=1000
# YUKI_GID=1000
