# === Yuki - variables d'environnement ===
# Basées sur les valeurs par défaut du docker-compose.yml

# UID/GID (doit rester 1000, image construite ainsi)
YUKI_UID=1000
YUKI_GID=1000

# Image / version (latest n'existe que si une release a été lancée → test sinon)
YUKI_VERSION=test

# Port hôte du gateway
YUKI_GATEWAY_PORT=8083

# Logging
YUKI_LOG_LEVEL=info

# === Service TTS (Lot 7) ===
# Le service `tts` DÉMARRE AVEC LA STACK : il n'est plus derrière un profil
# Compose (`docker compose up -d` le lance). Pour l'exclure, cibler le gateway :
#     docker compose up -d gateway
# Image audio.cpp (CUDA NVIDIA uniquement) : `full-cuda13` par défaut,
# `full-cuda12` si le driver l'impose.
# YUKI_TTS_IMAGE=ghcr.io/0xshug0/audio.cpp:full-cuda13
#
# ⚠️ Le service monte le DOSSIER `./tts-config` (bind) : le gateway en `rw`
# sur `/data/tts-config`, le moteur `tts` en `ro` sur `/config`. Créer ce
# dossier AVANT `docker compose up` et y placer `server.json` (copié depuis
# `audiocpp-server.json.example`), puis renseigner le chemin RÉEL du GGUF
# (`models[].path`, vue moteur : `/models/…`) :
#     mkdir -p tts-config && cp audiocpp-server.json.example tts-config/server.json
# La page /config, onglet Voix, permet ensuite d'éditer `server.json` de façon
# STRUCTURÉE (listes fermées, jamais de JSON brut) ; le moteur ne le relit qu'à
# son redémarrage (1 clic dans votre UI Docker).
