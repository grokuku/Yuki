# === Yuki — déploiement minimal ===
# Ces 5 variables sont le SEUL câblage. Tout le reste (clés LLM, GPU, prompts…)
# se règle depuis la page /config, persistée sur le volume `state`.

# UID/GID : DOIVENT rester 1000 — l'image publiée est construite avec 1000.
YUKI_UID=1000
YUKI_GID=1000

# Image à tirer : `test` (CI, toujours publiée) ou `latest`/`<version>` (release).
YUKI_VERSION=test

# Port HÔTE exposé (le port conteneur reste 8080).
YUKI_GATEWAY_PORT=8083

# Verbosité des logs : debug | info | warn | error.
YUKI_LOG_LEVEL=info
