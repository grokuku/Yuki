# =============================================================================
# Yuki — catalogue complet des variables d'environnement (Lots 0-1)
#
#   cp .env.example .env
#
# ⚠️  Toutes les valeurs ci-dessous sont FACTICES (exemples de développement).
#     Aucun secret réel ne doit jamais être écrit dans ce fichier.
#     `.env` est gitignoré.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=production
# Version de l'application (rapportée par /version).
# ⚠️ Elle sert AUSSI de tag d'image : `ghcr.io/grokuku/yuki:${YUKI_VERSION:-latest}`.
# Laissée commentée, l'image tirée est `:latest` et l'app utilise son défaut.
# Décommenter pour épingler une version publiée précise (ex. 0.1.0).
# YUKI_VERSION=0.1.0
# debug | info | warn | error
YUKI_LOG_LEVEL=info

# --- Gateway HTTP ------------------------------------------------------------
YUKI_GATEWAY_PORT=8080
YUKI_GATEWAY_HOST=0.0.0.0

# --- Porte de compatibilité --------------------------------------------------
# strict       : refus explicite et bruyant si le profil requis n'est pas tenu
# auto-degrade : sélectionne le plus haut profil compatible et démarre
YUKI_COMPAT_MODE=strict
# Profil forcé : confort | compact | repli | texte-seul. Vide = résolution auto.
YUKI_PROFILE=

# --- Détection GPU -----------------------------------------------------------
# Commande exécutée pour interroger le GPU (vide = défaut du code : nvidia-smi).
# Décommenter uniquement pour surcharger (la surcharge force source=env-override).
# YUKI_GPU_CMD=nvidia-smi
# Fixture nvidia-smi (mode simulé). Vide = exécution réelle. Développement/tests.
YUKI_GPU_FIXTURE=
# Driver NVIDIA minimal (majeure) exigé par les SERVICES vocaux (asr/tts).
# N'influence PAS la résolution de profil : au Lot 0 aucun conteneur n'utilise CUDA.
YUKI_MIN_DRIVER=580

# --- Identité conteneur (exécution non-root) ---------------------------------
# ⚠️ L'image tirée est construite par la CI avec uid/gid 1000 (voir le
#    `ARG YUKI_UID/YUKI_GID` du Dockerfile). Changer ces valeurs SANS
#    reconstruire l'image fait tourner le conteneur avec un uid différent de
#    celui du volume nommé → erreurs de permissions (`/health/ready` → 503).
#    Ne les modifier qu'en reconstruisant l'image avec les mêmes valeurs
#    (voir `compose.build.example.yml`).
YUKI_UID=1000
YUKI_GID=1000

# --- Volumes (chemins CONTENEUR — cibles des volumes nommés du compose) -------
# La persistance passe par des VOLUMES NOMMÉS Docker (yuki-pi, yuki-workspace,
# yuki-models, yuki-state) : aucune préparation de dossier sur l'hôte n'est
# nécessaire. Pour revenir à des bind mounts (`./.local/…`), voir
# `compose.bind.example.yml`.
# /data/pi        rw  — agent Pi (SDK, état)
# /workspace      rw  — espace de travail de l'exécutant
# /models         ro  — poids de modèles (lecture seule)
# /data/state     rw  — état persistant du gateway
YUKI_MOUNT_PI_AGENT=/data/pi
YUKI_MOUNT_WORKSPACE=/workspace
YUKI_MOUNT_MODELS=/models
YUKI_MOUNT_STATE=/data/state

# --- Configuration -----------------------------------------------------------
# Répertoire des manifestes (gpu-profiles.json, compat-manifest.json).
YUKI_CONFIG_DIR=./config

# --- Pi embarqué (Lot 1) -----------------------------------------------------
# État du SDK Pi redirigé sur le volume `yuki-pi` (rootfs read-only).
YUKI_PI_AGENT_DIR=/data/pi/agent
YUKI_PI_SESSIONS_DIR=/data/pi/agent/sessions
# HOME inscriptible dédié (replis du SDK via os.homedir()).
YUKI_PI_HOME=/data/pi/home
# cwd fixe : le SDK nomme le dossier de sessions d'après lui (--workspace--).
YUKI_PI_CWD=/workspace
# Prompt système généraliste et seed des réglages (dans l'image, lecture seule).
YUKI_PI_SYSTEM_PROMPT=./config/pi/system-prompt.md
YUKI_PI_SETTINGS_SEED=./config/pi/settings.json
# Seed de models.json (providers/modèles neutres `llm-light`/`llm-heavy`,
# références de clés uniquement). Seedé sur le volume au premier démarrage.
YUKI_PI_MODELS_SEED=./config/pi/models.json
# Prompt système dédié au worker lourd.
YUKI_PI_HEAVY_SYSTEM_PROMPT=./config/pi/system-prompt-heavy.md
# Modèle par défaut `provider/modelId` (vide = llm-light/gemma4:31b).
# Surcharge explicite ; préférer `YUKI_LLM_LIGHT_MODEL` (voir Lot 2 plus bas).
YUKI_PI_MODEL=
# Niveau de raisonnement : off | minimal | low | medium | high | xhigh | max.
# (vide = off pour le léger ; le lourd pense en `high` par défaut)
# Surcharge explicite ; préférer `YUKI_LLM_LIGHT_THINKING`.
YUKI_PI_THINKING=

# --- Multi-LLM & jobs (Lot 2) ------------------------------------------------
# Politique en cas de clé LLM absente : degrade (défaut) | refuse.
#   degrade : démarre pour diagnostic ; le lourd absent désactive la délégation.
#   refuse  : sortie non-zéro AVANT d'ouvrir le port.
YUKI_LLM_MISSING_KEY_MODE=degrade
# Journal append-only des jobs (volume `state`).
YUKI_JOBS_STORE_PATH=/data/state/jobs.jsonl
# Concurrence du worker lourd : 3 simultanés + file de 10.
YUKI_HEAVY_MAX_CONCURRENT=3
YUKI_HEAVY_MAX_QUEUE=10
# Timeouts du worker lourd : inactivité 120 s, global 20 min.
YUKI_HEAVY_IDLE_TIMEOUT_MS=120000
YUKI_HEAVY_TOTAL_TIMEOUT_MS=1200000

# --- Transport temps réel (Lot 1) --------------------------------------------
# Capacité du buffer de rejeu par session (trames) et borne en octets.
YUKI_WS_REPLAY_BUFFER=1000
YUKI_WS_REPLAY_BYTES=5000000

# --- Secrets LLM (Lot 2) — JAMAIS commités, JAMAIS en clair dans les logs ----
# Nommage NEUTRE, par RÔLE : on peut changer de fournisseur sans toucher au code.
# `config/pi/models.json` référence les clés par `$YUKI_LLM_LIGHT_API_KEY` /
# `$YUKI_LLM_HEAVY_API_KEY` — le SDK les résout au moment de la requête.
# ⚠️ `baseUrl`, `api` et l'identifiant de modèle NE PEUVENT PAS être interpolés
#    dans `models.json` (seuls `apiKey`/`headers` le sont par le SDK). Ces valeurs
#    restent donc littérales dans `config/pi/models.json` (seedé sur le volume) :
#    c'est LE seul fichier à éditer pour changer de fournisseur.
#
# Bloc neutre — valeurs actuelles : ollamacloud (https://ollama.com/v1).
# Chaque rôle a sa propre `BASE_URL` (léger et lourd peuvent être chez deux
# fournisseurs différents) et sa propre clé (le léger ne fait jamais la queue
# derrière le lourd).
#
#   api      : type d'API du SDK (openai-completions)
#   baseUrl  : endpoint compatible OpenAI (aussi dans models.json)
#   model    : identifiant passé à l'API (doit exister dans models.json)
#   thinking : off | minimal | low | medium | high | xhigh | max

# Léger — compte dédié (1 flux concurrent).
YUKI_LLM_LIGHT_API=openai-completions
YUKI_LLM_LIGHT_BASE_URL=https://ollama.com/v1
YUKI_LLM_LIGHT_API_KEY=fake-light-key-0000000000000000
YUKI_LLM_LIGHT_MODEL=gemma4:31b
YUKI_LLM_LIGHT_THINKING=off

# Lourd — compte dédié (3 requêtes concurrentes, arrière-plan).
YUKI_LLM_HEAVY_API=openai-completions
YUKI_LLM_HEAVY_BASE_URL=https://ollama.com/v1
YUKI_LLM_HEAVY_API_KEY=fake-heavy-key-1111111111111111
YUKI_LLM_HEAVY_MODEL=deepseek-v4.1-flash
YUKI_LLM_HEAVY_THINKING=high
